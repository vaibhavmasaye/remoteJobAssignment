generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SourceConnection {
  id                   String           @id @db.VarChar(255)
  source               String           @db.VarChar(50)
  accountExternalId    String?          @map("account_external_id") @db.VarChar(255)
  status               String           @default("ACTIVE") @db.VarChar(50)
  encryptedCredentials String?          @map("encrypted_credentials")
  lastSuccessAt        DateTime?        @map("last_success_at")
  lastErrorAt          DateTime?        @map("last_error_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")
  checkpoints          SyncCheckpoint[]
  externalRecords      ExternalRecord[]
  failedRecords        FailedRecord[]
  sourceSyncRuns       SourceSyncRun[]

  @@unique([source, accountExternalId])
  @@index([status])
  @@index([lastErrorAt])
  @@map("source_connections")
}

model SyncCheckpoint {
  id                    String           @id @db.VarChar(255)
  connectionId          String           @map("connection_id") @db.VarChar(255)
  objectType            String           @map("object_type") @db.VarChar(255)
  cursor                String?
  watermark             DateTime?
  cursorVersion         Int              @default(1) @map("cursor_version")
  lastFullSyncAt        DateTime?        @map("last_full_sync_at")
  lastIncrementalSyncAt DateTime?        @map("last_incremental_sync_at")
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at")
  connection            SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, objectType])
  @@index([connectionId])
  @@map("sync_checkpoints")
}

model ExternalRecord {
  id                String             @id @db.VarChar(255)
  connectionId      String             @map("connection_id") @db.VarChar(255)
  objectType        String             @map("object_type") @db.VarChar(255)
  externalId        String             @map("external_id") @db.VarChar(255)
  data              Json
  syncedAt          DateTime?          @map("synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  connection        SourceConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  normalizedRecords NormalizedRecord[]

  @@unique([connectionId, objectType, externalId])
  @@index([connectionId])
  @@index([syncedAt])
  @@map("external_records")
}

model NormalizedRecord {
  id               String          @id @db.VarChar(255)
  source           String          @db.VarChar(50)
  entityType       String          @map("entity_type") @db.VarChar(100)
  entityData       Json            @map("entity_data")
  externalRecordId String?         @map("external_record_id") @db.VarChar(255)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  externalRecord   ExternalRecord? @relation(fields: [externalRecordId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([entityType])
  @@map("normalized_data")
}

model FailedRecord {
  id           String           @id @db.VarChar(255)
  connectionId String           @map("connection_id") @db.VarChar(255)
  objectType   String           @map("object_type") @db.VarChar(255)
  externalId   String?          @map("external_id") @db.VarChar(255)
  errorMessage String           @map("error_message")
  errorStack   String?          @map("error_stack")
  retryCount   Int              @default(0) @map("retry_count")
  lastRetryAt  DateTime?        @map("last_retry_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  connection   SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([retryCount])
  @@map("failed_records")
}

model SyncRun {
  id             String          @id @db.VarChar(255)
  correlationId  String          @map("correlation_id") @db.VarChar(255)
  status         String          @db.VarChar(50)
  triggerType    String          @map("trigger_type") @db.VarChar(50)
  requestedBy    String?         @map("requested_by") @db.VarChar(255)
  startedAt      DateTime        @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  errorMessage   String?         @map("error_message")
  summary        Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  sourceSyncRuns SourceSyncRun[]

  @@index([status])
  @@index([startedAt])
  @@index([correlationId])
  @@map("sync_runs")
}

model SourceSyncRun {
  id           String           @id @db.VarChar(255)
  syncRunId    String           @map("sync_run_id") @db.VarChar(255)
  connectionId String           @map("connection_id") @db.VarChar(255)
  source       String           @db.VarChar(50)
  mode         String           @db.VarChar(50)
  status       String           @db.VarChar(50)
  recordCount  Int              @default(0) @map("record_count")
  errorMessage String?          @map("error_message")
  startedAt    DateTime         @map("started_at")
  finishedAt   DateTime?        @map("finished_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  syncRun      SyncRun          @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  connection   SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([connectionId])
  @@index([status])
  @@map("source_sync_runs")
}

model WebhookEvent {
  id           String    @id @db.VarChar(255)
  source       String    @db.VarChar(50)
  eventType    String    @map("event_type") @db.VarChar(100)
  payload      Json
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([source])
  @@index([processedAt])
  @@map("webhook_events")
}
