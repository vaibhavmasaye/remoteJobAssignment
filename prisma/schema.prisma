generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SOURCE CONNECTIONS
// ============================================================================

model SourceConnection {
  id                    String                @id @default(cuid())
  source                SourceType
  accountExternalId     String?
  status                ConnectionStatus      @default(ACTIVE)
  encryptedCredentials  Json?
  lastSuccessAt         DateTime?
  lastErrorAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  checkpoints           SyncCheckpoint[]
  externalRecords       ExternalRecord[]
  sourceSyncRuns        SourceSyncRun[]
  failedRecords         FailedRecord[]

  @@unique([source, accountExternalId])
  @@index([status])
  @@index([lastErrorAt])
}

// ============================================================================
// SYNC CHECKPOINTS (Cursors, watermarks, state for incremental sync)
// ============================================================================

model SyncCheckpoint {
  id                  String          @id @default(cuid())
  connectionId        String
  objectType          String
  cursor              String?
  watermark           DateTime?
  cursorVersion       Int             @default(1)
  lastFullSyncAt      DateTime?
  lastIncrementalSyncAt DateTime?
  updatedAt           DateTime        @updatedAt

  // Relations
  connection          SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, objectType])
  @@index([connectionId])
  @@index([updatedAt])
}

// ============================================================================
// SYNC RUNS (Parent orchestration records)
// ============================================================================

model SyncRun {
  id              String            @id @default(cuid())
  correlationId   String            @unique @default(cuid())
  triggerType     SyncTriggerType
  status          SyncRunStatus
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  requestedBy     String?
  summary         Json?

  // Relations
  sourceSyncRuns  SourceSyncRun[]

  @@index([status])
  @@index([startedAt])
  @@index([finishedAt])
}

model SourceSyncRun {
  id              String            @id @default(cuid())
  syncRunId       String
  connectionId    String
  source          SourceType
  mode            SyncMode          @default(INCREMENTAL)
  status          SourceRunStatus
  recordsSeen     Int               @default(0)
  recordsWritten  Int               @default(0)
  recordsSkipped  Int               @default(0)
  recordsFailed   Int               @default(0)
  cursorBefore    String?
  cursorAfter     String?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  // Relations
  syncRun         SyncRun           @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  connection      SourceConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  failedRecords   FailedRecord[]

  @@index([syncRunId])
  @@index([connectionId])
  @@index([status])
  @@index([startedAt])
}

// ============================================================================
// EXTERNAL RECORDS (Source identity and traceability)
// ============================================================================

model ExternalRecord {
  id                String          @id @default(cuid())
  connectionId      String
  source            SourceType
  externalObjectType String
  externalId        String
  externalVersion   String?
  sourceUpdatedAt   DateTime?
  normalizedType    NormalizedType
  normalizedId      String
  isDeleted         Boolean         @default(false)
  rawPayload        Json?
  payloadHash       String?
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  connection        SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalObjectType, externalId])
  @@index([normalizedType])
  @@index([normalizedId])
  @@index([isDeleted])
  @@index([sourceUpdatedAt])
}

// ============================================================================
// NORMALIZED RECORD TYPES
// ============================================================================

model Person {
  id          String    @id @default(cuid())
  fullName    String?
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  companyName String?
  status      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([createdAt])
}

model Payment {
  id              String    @id @default(cuid())
  customerExternalId String?
  amountMinor     BigInt
  currency        String    @db.Char(3)
  status          String
  paymentMethodType String?
  paidAt          DateTime?
  refundedAmountMinor BigInt @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([paidAt])
  @@index([customerExternalId])
  @@index([createdAt])
}

model CalendarEvent {
  id                    String    @id @default(cuid())
  calendarExternalId    String
  summary               String?
  description           String?
  startAt               DateTime?
  endAt                 DateTime?
  isAllDay              Boolean   @default(false)
  timezone              String?
  status                String
  organizerEmail        String?
  attendees             Json?
  recurringEventExternalId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([calendarExternalId])
  @@index([createdAt])
}

// ============================================================================
// WEBHOOK AND EVENT DEDUPLICATION
// ============================================================================

model ProcessedWebhookEvent {
  id              String            @id @default(cuid())
  source          SourceType
  externalEventId String
  payloadHash     String
  receivedAt      DateTime          @default(now())
  processedAt     DateTime?
  status          WebhookEventStatus @default(RECEIVED)
  retryCount      Int               @default(0)
  lastError       String?

  @@unique([source, externalEventId])
  @@index([status])
  @@index([receivedAt])
}

// ============================================================================
// FAILED RECORDS (Dead-letter queue)
// ============================================================================

model FailedRecord {
  id                String      @id @default(cuid())
  sourceSyncRunId   String?
  connectionId      String
  source            SourceType
  externalObjectType String?
  externalId        String?
  stage             FailureStage
  errorCode         String
  errorMessage      String
  rawPayload        Json?
  retryable         Boolean     @default(true)
  retryCount        Int         @default(0)
  nextRetryAt       DateTime?
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  // Relations
  sourceSyncRun     SourceSyncRun?  @relation(fields: [sourceSyncRunId], references: [id], onDelete: SetNull)
  connection        SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([retryable])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([source])
}

// ============================================================================
// ENUMS
// ============================================================================

enum SourceType {
  HUBSPOT
  STRIPE
  GOOGLE_CALENDAR
}

enum ConnectionStatus {
  ACTIVE
  DEGRADED
  DISABLED
  AUTH_REQUIRED
}

enum SyncTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  RECOVERY
}

enum SyncRunStatus {
  RUNNING
  PARTIAL_SUCCESS
  SUCCESS
  FAILED
}

enum SourceRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  FALLBACK_FULL
}

enum SyncMode {
  INCREMENTAL
  FULL
  WEBHOOK_RECONCILE
}

enum NormalizedType {
  PERSON
  PAYMENT
  CALENDAR_EVENT
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum FailureStage {
  FETCH
  VALIDATE
  NORMALIZE
  WRITE
}

